        <section class="relative overflow-hidden bg-[#2D2D2D] py-20 px-6 text-center">
            <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
                <div class="absolute -top-16 -left-16 w-64 h-64 rounded-full bg-[#FF6B6B] opacity-10"></div>
                <div class="absolute -bottom-16 -right-16 w-64 h-64 rounded-full bg-[#4ECDC4] opacity-10"></div>
            </div>
            <div class="relative z-10 max-w-xl mx-auto">
                <h2 class="text-4xl font-semibold text-white mb-4" style="font-family: Fraunces, Georgia, serif;">Prêt à créer votre liste de naissance ?</h2>
                <p class="text-white/60 text-lg mb-8">Créez la liste de naissance de votre bébé en moins d'une minute.</p><a class="inline-block bg-[#FF6B6B] text-white font-semibold px-10 py-4 rounded-full hover:bg-[#e85555] active:scale-95 transition shadow-lg text-lg" href="{{ path('app_register') }}" data-discover="true">Créer ma liste de naissance — c’est gratuit</a></div>
        </section>
        <footer class="bg-[#2D2D2D] border-t border-white/10 py-8 text-center text-xs text-white/30">
            <p>Made with ❤️ for growing families · by <a href="https://guillaume-gorvel.fr">Guillaume Gorvel</a> © 2026</p>
        </footer>
    </div>
{% endblock %}
