<nav class="relative z-20 flex items-center justify-between px-8 py-5 max-w-6xl mx-auto">
    <div class="flex items-center gap-2">
        <span class="text-xl">🌿</span>
        <span class="font-title text-lg font-semibold text-[#2D2D2D]">MyWishlist</span>
    </div>
    {% if app.user is null  %}
    <div class="flex items-center gap-4">
        <a
            class="text-sm font-medium text-[#6B6B6B] hover:text-[#2D2D2D] transition"
            href="{{ path('app_login', {redirect: app.request.requestUri}) }}"
            data-discover="true">
            Se connecter
        </a>
        <a
            class="text-sm font-semibold bg-[#2D2D2D] text-white px-5 py-2 rounded-full hover:bg-[#444] active:scale-95 transition"
            href="{{ path('app_login', {
                    redirect: app.request.requestUri,
                    tab: 'register'
            }) }}"
            data-discover="true">S'inscrire
        </a>
    </div>
    {% else %}
        <div class="flex items-center gap-4">
            <p>Bonjour, {{ app.user.firstname }} </p>
            <a
                class="text-sm font-semibold bg-[#2D2D2D] text-white px-5 py-2 rounded-full hover:bg-[#444] active:scale-95 transition"
                href="{{ path('app_dashboard')
                }}">
                Mes listes de naissance
            </a>
            <a
                class="text-sm font-semibold bg-[#FF6B6B] text-white px-5 py-2 rounded-full hover:bg-[#e85555] active:scale-95 transition"
                href="{{ path('app_logout') }}">Se déconnecter</a>
        </div>
    {% endif %}
</nav>
