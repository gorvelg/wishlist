<div data-controller="rules">

    {# ========================================================== #}
    {# BANDEAU                                                   #}
    {# ========================================================== #}

    <div class="max-w-5xl mx-auto px-6 mt-6">

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-[#FFF8F0] border border-[rgba(45,45,45,0.08)] rounded-2xl px-4 py-3">

            <div class="flex items-start gap-3">

                <span aria-hidden="true" class="flex items-center justify-center size-8 rounded-full bg-[#FFE66D] shrink-0">
                    💡
                </span>

                <div>

                    <p class="text-sm font-semibold text-[#2D2D2D]">
                        Comment fonctionne Nidou ?
                    </p>

                    <p class="text-xs text-[#6B6B6B] mt-0.5">
                        Offrez un cadeau seul ou participez à plusieurs. Aucun paiement n'est effectué sur Nidou.
                    </p>

                </div>

            </div>

            <button type="button" data-rules-target="button" data-action="click->rules#open" aria-haspopup="dialog" aria-expanded="false" aria-controls="wishlist-rules-modal" class="text-xs font-semibold text-[#4ECDC4] hover:text-[#3ab8b0] hover:underline shrink-0">
                Voir les règles
            </button>

        </div>

    </div>


    {# ========================================================== #}
    {# MODALE                                                    #}
    {# ========================================================== #}

    <div id="wishlist-rules-modal" data-rules-target="modal" data-action="click->rules#closeBackground keydown.esc@window->rules#close" class="hidden fixed inset-0 z-50 bg-black/30 backdrop-blur-[1px] flex items-center justify-center p-4">

        <div role="dialog" aria-modal="true" aria-labelledby="wishlist-rules-title" aria-describedby="wishlist-rules-description" class="relative w-full max-w-md bg-white rounded-2xl shadow-xl overflow-hidden">


            {# ====================================================== #}
            {# HEADER                                                #}
            {# ====================================================== #}

            <div class="flex items-start justify-between gap-4 px-5 py-4 border-b border-[rgba(45,45,45,0.08)]">

                <div>

                    <h2 id="wishlist-rules-title" class="font-semibold text-lg text-[#2D2D2D]">
                        Comment fonctionne Nidou ?
                    </h2>

                    <p id="wishlist-rules-description" class="text-xs text-[#6B6B6B] mt-1">
                        Quelques règles simples pour offrir en toute simplicité.
                    </p>

                </div>

                <button type="button" data-rules-target="closeButton" data-action="click->rules#close" aria-label="Fermer les règles de Nidou" class="flex items-center justify-center size-8 rounded-full text-[#6B6B6B] hover:text-[#2D2D2D] hover:bg-[#FFF8F0] transition shrink-0">
                    ✕
                </button>

            </div>


            {# ====================================================== #}
            {# RÈGLES                                                #}
            {# ====================================================== #}

            <div class="px-5 py-5 flex flex-col gap-4">


                {# ================================================== #}
                {# OFFRIR                                            #}
                {# ================================================== #}

                <div class="flex items-start gap-3">

                    <span aria-hidden="true" class="flex items-center justify-center size-8 rounded-full bg-[#FFE66D] text-sm shrink-0">
                        <img src="{{ asset('images/cadeau.png') }}" alt="cadeau" class="size-4">
                    </span>

                    <div>

                        <p class="text-sm font-semibold text-[#2D2D2D]">
                            Offrir
                        </p>

                        <p class="text-xs text-[#6B6B6B] mt-1 leading-relaxed">
                            Vous choisissez de prendre en charge la totalité du cadeau.
                        </p>

                    </div>

                </div>


                {# ================================================== #}
                {# OFFRIR À PLUSIEURS                                #}
                {# ================================================== #}

                <div class="flex items-start gap-3">

                    <span aria-hidden="true" class="flex items-center justify-center size-8 rounded-full bg-[#CFF5F2] text-sm shrink-0">
                        👥
                    </span>

                    <div>

                        <p class="text-sm font-semibold text-[#2D2D2D]">
                            Offrir à plusieurs
                        </p>

                        <p class="text-xs text-[#6B6B6B] mt-1 leading-relaxed">
                            Vous choisissez librement le montant de votre participation. D'autres personnes peuvent ensuite compléter le cadeau.
                        </p>

                    </div>

                </div>


                {# ================================================== #}
                {# PARTICIPATION                                     #}
                {# ================================================== #}

                <div class="flex items-start gap-3">

                    <span aria-hidden="true" class="flex items-center justify-center size-8 rounded-full bg-[#FFE9EC] text-sm shrink-0">
                        <img src="{{ asset('images/crayon.png') }}" alt="crayon à papier" class="size-4">
                    </span>

                    <div>

                        <p class="text-sm font-semibold text-[#2D2D2D]">
                            Votre participation
                        </p>

                        <p class="text-xs text-[#6B6B6B] mt-1 leading-relaxed">
                            Tant que le cadeau n'est pas marqué comme acheté, vous pouvez modifier ou annuler votre participation.
                        </p>

                    </div>

                </div>


                {# ================================================== #}
                {# PAIEMENT                                          #}
                {# ================================================== #}

                <div class="flex items-start gap-3">

                    <span aria-hidden="true" class="flex items-center justify-center size-8 rounded-full bg-[#F1EDFA] text-sm shrink-0">
                        <img src="{{ asset('images/no-money.png') }}" alt="pas d'argent" class="size-full">
                    </span>

                    <div>

                        <p class="text-sm font-semibold text-[#2D2D2D]">
                            Aucun paiement sur Nidou
                        </p>

                        <p class="text-xs text-[#6B6B6B] mt-1 leading-relaxed">
                            Les montants indiqués correspondent à des engagements entre proches. Nidou ne collecte et ne transfère aucun argent.
                        </p>

                    </div>

                </div>


                {# ================================================== #}
                {# ORGANISATION                                      #}
                {# ================================================== #}

                <div class="flex items-start gap-3">

                    <span aria-hidden="true" class="flex items-center justify-center size-8 rounded-full bg-[#FFF8F0] text-sm shrink-0">
                        <img src="{{ asset('images/chat.png') }}" alt="bulle de discussion" class="size-4">
                    </span>

                    <div>

                        <p class="text-sm font-semibold text-[#2D2D2D]">
                            Organisez-vous entre participants
                        </p>

                        <p class="text-xs text-[#6B6B6B] mt-1 leading-relaxed">
                            Pour un cadeau offert à plusieurs, les participants s'organisent directement entre eux pour l'achat et le règlement.
                        </p>

                    </div>

                </div>

            </div>


            {# ====================================================== #}
            {# FOOTER                                                #}
            {# ====================================================== #}

            <div class="px-5 py-4 bg-[#FFF8F0] border-t border-[rgba(45,45,45,0.08)]">

                <button type="button" data-action="click->rules#close" class="w-full text-sm font-semibold bg-[#FFE66D] text-[#2D2D2D] px-4 py-2 rounded-xl hover:bg-[#ffd93d] active:scale-[0.99] transition">
                    J'ai compris
                </button>

            </div>

        </div>

    </div>

</div>
