<article
    data-product-category="{{ category.value }}"
    data-product-status="{{ status.value }}"
    class="
        relative
        rounded-2xl
        border
        bg-white
        overflow-hidden
        flex
        flex-col
        transition-shadow
        hover:shadow-lg
        border-[rgba(45,45,45,0.1)]
    "
>

    {# ========================================================== #}
    {# OVERLAY : PRODUIT ACHETÉ                                  #}
    {# ========================================================== #}

    {% if status.value == 'purchased' %}

        <div
            class="
                absolute
                inset-0
                bg-white/80
                backdrop-blur-[1px]
                flex
                flex-col
                items-center
                justify-center
                gap-3
                z-20
                rounded-2xl
            "
        >

            <div
                class="
                    flex
                    items-center
                    gap-2
                    bg-green-100
                    text-green-700
                    border
                    border-green-200
                    px-4
                    py-2
                    rounded-xl
                    text-sm
                    font-semibold
                "
            >
                <span>✓</span>

                <span>
                    Cadeau acheté
                </span>
            </div>


            {# ================================================== #}
            {# ANNULATION DU STATUT ACHETÉ                        #}
            {# uniquement pour un participant                     #}
            {# ================================================== #}

            {% if app.user and hasReserved %}

                <form
                    action="{{ path(
                        'app_product_cancel_purchased',
                        {
                            token: wishlistToken,
                            id: productId
                        }
                    ) }}"
                    method="post"

                >

                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token(
                            'cancel-purchased-' ~ productId
                        ) }}"
                    >

                    <button
                        type="submit"
                        class="
                            text-xs
                            font-medium
                            text-[#6B6B6B]
                            hover:text-[#FF6B6B]
                            hover:underline
                            transition
                        "
                    >
                        Annuler
                    </button>

                </form>

            {% endif %}

        </div>

    {% endif %}


    {# ========================================================== #}
    {# IMAGE                                                     #}
    {# ========================================================== #}

    <div class="h-36 w-full overflow-hidden relative">

        <img
            class="w-full h-full object-cover"
            src="{{ asset(product_upload_path ~ image) }}"
            alt="{{ name }}"
        >

        <div
            class="absolute inset-0"
            style="
                background:
                    linear-gradient(
                        transparent 40%,
                        rgba(0, 0, 0, 0.18) 100%
                    );
            "
        ></div>

        <div
            class="absolute bottom-0 left-0 h-1 w-full"
            style="background: rgb(255, 154, 92);"
        ></div>


        {# ====================================================== #}
        {# COULEURS DES PARTICIPANTS                              #}
        {# ====================================================== #}

        {% set badgeColors = [
            'bg-red-100 text-red-700',
            'bg-blue-100 text-blue-700',
            'bg-green-100 text-green-700',
            'bg-yellow-100 text-yellow-700',
            'bg-purple-100 text-purple-700',
            'bg-pink-100 text-pink-700',
            'bg-orange-100 text-orange-700',
            'bg-teal-100 text-teal-700'
        ] %}


        {# ====================================================== #}
        {# PARTICIPANTS                                          #}
        {# ====================================================== #}

        {% if productUsers|length > 0 %}

            <div
                class="
                    absolute
                    left-5
                    bottom-2.5
                    flex
                    items-center
                    gap-1
                "
            >

                {% for productUser in productUsers %}

                    {% set user = productUser.user %}

                    {% set color =
                        badgeColors[
                        user.id % badgeColors|length
                        ]
                    %}

                    <span
                        class="
                            flex
                            items-center
                            justify-center
                            size-7
                            rounded-full
                            border-2
                            border-white
                            text-xs
                            font-semibold
                            {{ color }}
                        "
                        title="{{ user.firstname }} {{ user.lastname }}"
                    >
                        {{ user.initials }}
                    </span>

                {% endfor %}

            </div>

        {% endif %}

    </div>


    {# ========================================================== #}
    {# CONTENU DE LA CARTE                                       #}
    {# ========================================================== #}

    <div
        class="
            p-5
            flex
            flex-col
            gap-3
            flex-1
            bg-white
            justify-between
        "
    >

        <div>

            <div class="flex justify-between gap-2">

                <h3 class="font-semibold">
                    {{ name }}
                </h3>

                {% include 'components/_tag.html.twig' with {
                    label: category.toFrench(),
                    variant: category.value
                } only %}

            </div>


            {% if description is not null %}

                <p class="text-xs mt-2">
                    {{ description }}
                </p>

            {% endif %}

        </div>


        <div>

            {# ================================================== #}
            {# PRIX                                               #}
            {# ================================================== #}

            <p
                class="
                    text-sm
                    font-semibold
                    text-[#2D2D2D]
                    mt-2
                "
            >
                {{ price }} €
            </p>


            {# ================================================== #}
            {# ACTIONS                                            #}
            {# ================================================== #}

            <div
                class="
                    flex
                    items-center
                    gap-2
                    mt-2
                    pt-1
                "
            >

                {# ============================================== #}
                {# VOIR LE PRODUIT                               #}
                {# ============================================== #}

                {% if url %}

                    <a
                        href="{{ url }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="
                            flex
                            items-center
                            gap-1
                            text-xs
                            font-semibold
                            text-white
                            bg-[#4ECDC4]
                            hover:bg-[#3ab8b0]
                            active:scale-95
                            transition
                            px-3
                            py-1.5
                            rounded-lg
                        "
                    >
                        Voir
                    </a>

                {% endif %}


                {# ============================================== #}
                {# ACTIONS UNIQUEMENT SI NON ACHETÉ              #}
                {# ============================================== #}

                {% if status.value != 'purchased' %}


                    {# ========================================== #}
                    {# UTILISATEUR CONNECTÉ                      #}
                    {# ========================================== #}

                    {% if app.user %}

                        <div
                            class="
                                ml-auto
                                flex
                                items-center
                                gap-2
                            "
                        >

                            {# ================================== #}
                            {# CLAIM / ANNULER LE CLAIM           #}
                            {# ================================== #}

                            <form
                                action="{{ path(
                                    'app_product_purchase',
                                    {
                                        token: wishlistToken,
                                        id: productId
                                    }
                                ) }}"
                                method="post"
                            >

                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token(
                                        'purchase-' ~ productId
                                    ) }}"
                                >


                                <button
                                    type="submit"
                                    class="
                                        {{
                                    hasReserved
                                    ? 'bg-red-100 border border-red-400 text-red-700 hover:bg-red-200'
                                    : 'bg-[#FFF8F0] border border-[rgba(45,45,45,0.12)] text-[#2D2D2D] hover:bg-[#FFE66D]'
                                    }}

                                        text-xs
                                        font-medium
                                        px-3
                                        py-1.5
                                        rounded-lg
                                        transition-colors
                                    "
                                >
                                    {{
                                    hasReserved
                                    ? 'Annuler'
                                    : 'Offrir'
                                    }}
                                </button>

                            </form>


                            {# ================================== #}
                            {# MARQUER COMME ACHETÉ               #}
                            {# uniquement si on participe         #}
                            {# ================================== #}

                            {% if hasReserved %}

                                <form
                                    action="{{ path(
                                        'app_product_mark_purchased',
                                        {
                                            token: wishlistToken,
                                            id: productId
                                        }
                                    ) }}"
                                    method="post"
                                >

                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token(
                                            'product-purchased-' ~ productId
                                        ) }}"
                                    >


                                    <button
                                        type="submit"
                                        class="
                                            text-xs
                                            bg-[#FFF8F0]
                                            border
                                            border-[rgba(45,45,45,0.12)]
                                            text-[#2D2D2D]
                                            font-medium
                                            px-3
                                            py-1.5
                                            rounded-lg
                                            hover:bg-[#FFE66D]
                                            transition-colors
                                        "
                                    >
                                        Je l'ai acheté
                                    </button>

                                </form>

                            {% endif %}

                        </div>


                        {# ========================================== #}
                        {# UTILISATEUR NON CONNECTÉ                  #}
                        {# ========================================== #}

                    {% else %}

                        <a
                            href="{{ path(
                                'app_login',
                                {
                                    redirect: path(
                                    'app_wishlist',
                                    {
                                        token: wishlistToken
                                    }
                                )
                                }
                            ) }}"
                            class="
                                ml-auto
                                text-xs
                                bg-[#FFF8F0]
                                border
                                border-[rgba(45,45,45,0.12)]
                                text-[#2D2D2D]
                                font-medium
                                px-3
                                py-1.5
                                rounded-lg
                                hover:bg-[#FFE66D]
                                transition-colors
                            "
                        >
                            Offrir
                        </a>

                    {% endif %}

                {% endif %}

            </div>

        </div>

    </div>

</article>
