<article data-product-category="{{ category.value }}" data-product-status="{{ status.value }}" class="relative rounded-2xl border bg-white overflow-hidden flex flex-col transition-shadow hover:shadow-lg border-[rgba(45,45,45,0.1)]">

    {# ========================================================== #}
    {# OVERLAY : PRODUIT ACHETÉ                                  #}
    {# ========================================================== #}

    {% if status.value == 'purchased' %}

        <div class="absolute inset-0 bg-white/80 backdrop-blur-[1px] flex flex-col items-center justify-center gap-3 z-20 rounded-2xl">

            <div class="flex items-center gap-2 bg-green-100 text-green-700 border border-green-200 px-4 py-2 rounded-xl text-sm font-semibold">
                <span>✓</span>
                <span>Cadeau acheté</span>
            </div>

            {# ================================================== #}
            {# ANNULER LE STATUT ACHETÉ                          #}
            {# uniquement pour un participant                    #}
            {# ================================================== #}

            {% if app.user and hasReserved %}

                <form action="{{ path('app_product_cancel_purchased', {token: wishlistToken, id: productId}) }}" method="post">

                    <input type="hidden" name="_token" value="{{ csrf_token('cancel-purchased-' ~ productId) }}">

                    <button type="submit" class="text-xs font-medium text-[#6B6B6B] hover:text-[#FF6B6B] hover:underline transition">
                        Annuler l'achat
                    </button>

                </form>

            {% endif %}

        </div>

    {% endif %}


    {# ========================================================== #}
    {# IMAGE                                                     #}
    {# ========================================================== #}

    <div class="h-36 w-full overflow-hidden relative">

        {# ====================================================== #}
        {# ACTIONS PROPRIÉTAIRE                                  #}
        {# ====================================================== #}

        {% if isOwner %}

            <div class="absolute z-10 right-3 top-1 flex items-center gap-1">

                <a class="bg-white rounded-full p-0.5 shadow-2xl text-[#2D2D2D]" href="{{ path('app_wishlist', {token: wishlistToken, edit: productId}) }}">
                    {% include 'components/icons/edit.html.twig' %}
                </a>

                <form class="text-[#2D2D2D] hover:text-red-700 transition-colors block bg-white rounded-full p-0.5 shadow-2xl" method="post" action="{{ path('app_product_delete', {id: productId}) }}" onsubmit="return confirm('Supprimer ce produit ?');">

                    <input type="hidden" name="_token" value="{{ csrf_token('delete_product_' ~ productId) }}">

                    <button class="block" type="submit">
                        {% include 'components/icons/trash.html.twig' %}
                    </button>

                </form>

            </div>

        {% endif %}


        {# ====================================================== #}
        {# IMAGE PRODUIT                                         #}
        {# ====================================================== #}

        {% if image %}

            {% set imageSrc = image %}

            {% if not (image starts with 'http://' or image starts with 'https://') %}
                {% set imageSrc = asset(product_upload_path ~ image) %}
            {% endif %}

            <img class="w-full h-full object-cover" src="{{ imageSrc }}" alt="{{ name }}">

        {% else %}

            <div class="w-full h-full flex items-center justify-center bg-[#FFF8F0] text-[#6B6B6B] text-sm">
                Aucune image
            </div>

        {% endif %}


        {# Dégradé sur le bas de l'image #}

        <div class="absolute inset-0" style="background: linear-gradient(transparent 40%, rgba(0, 0, 0, 0.18) 100%);"></div>

        <div class="absolute bottom-0 left-0 h-1 w-full" style="background: rgb(255, 154, 92);"></div>


        {# ====================================================== #}
        {# COULEURS DES PARTICIPANTS                             #}
        {# ====================================================== #}

        {% set badgeColors = [
            'bg-red-100 text-red-700',
            'bg-blue-100 text-blue-700',
            'bg-green-100 text-green-700',
            'bg-yellow-100 text-yellow-700',
            'bg-purple-100 text-purple-700',
            'bg-pink-100 text-pink-700',
            'bg-orange-100 text-orange-700',
            'bg-teal-100 text-teal-700'
        ] %}


        {# ====================================================== #}
        {# PARTICIPANTS                                          #}
        {# ====================================================== #}

        {% if productUsers|length > 0 %}

            <div class="absolute left-5 bottom-2.5 flex items-center gap-1">

                {% for productUser in productUsers %}

                    {% set user = productUser.user %}
                    {% set color = badgeColors[user.id % badgeColors|length] %}

                    <span class="flex items-center justify-center size-7 rounded-full border-2 border-white text-xs font-semibold {{ color }}" title="{{ user.firstname }} {{ user.lastname }}{% if productUser.amount %} — {{ productUser.amount|number_format(2, ',', ' ') }} €{% endif %}">
                        {{ user.initials }}
                    </span>

                {% endfor %}

            </div>

        {% endif %}

    </div>


    {# ========================================================== #}
    {# CONTENU DE LA CARTE                                       #}
    {# ========================================================== #}

    <div class="p-5 flex flex-col gap-4 flex-1 bg-white">


        {# ====================================================== #}
        {# TITRE + CATÉGORIE                                     #}
        {# ====================================================== #}

        <div>

            <div class="flex justify-between items-start gap-2">

                <h3 class="font-semibold text-[#2D2D2D]">
                    {{ name }}
                </h3>

                {% include 'components/_tag.html.twig' with {
                    label: category.toFrench(),
                    variant: category.value
                } only %}

            </div>


            {# ================================================== #}
            {# DESCRIPTION                                       #}
            {# ================================================== #}

            {% if description is not null and description != '' %}

                <p class="text-xs text-[#6B6B6B] mt-2 leading-relaxed">
                    {{ description }}
                </p>

            {% endif %}

        </div>


        {# ====================================================== #}
        {# PRIX                                                  #}
        {# ====================================================== #}

        <p class="text-lg font-semibold text-[#2D2D2D]">
            {{ price|number_format(2, ',', ' ') }} €
        </p>


        {# ====================================================== #}
        {# PROGRESSION DES PARTICIPATIONS                        #}
        {# ====================================================== #}

        <div>

            <div class="flex items-center justify-between text-xs text-[#6B6B6B] mb-2">

                <span>
                    {{ contributedAmount|number_format(2, ',', ' ') }} € promis
                </span>

                <span>
                    {{ contributionPercent|number_format(0) }} %
                </span>

            </div>


            <div class="w-full h-2 bg-[#F1F1F1] rounded-full overflow-hidden">

                <div class="h-full bg-[#4ECDC4] rounded-full transition-all" style="width: {{ contributionPercent }}%"></div>

            </div>


            {% if remainingAmount > 0 %}

                <div class="text-xs text-[#6B6B6B] mt-2">
                    Il reste
                    <strong class="text-[#2D2D2D]">
                        {{ remainingAmount|number_format(2, ',', ' ') }} €
                    </strong>
                    à financer
                </div>

            {% else %}

                <div class="flex items-center gap-1 text-xs font-semibold text-[#4ECDC4] mt-2">
                    <span>✓</span>
                    <span>Montant entièrement réparti</span>
                </div>

            {% endif %}

        </div>


        {# ====================================================== #}
        {# PARTICIPATION                                         #}
        {# ====================================================== #}

        {% if status.value != 'purchased' %}

            {% if app.user %}

                {% include 'components/_participation-form.html.twig' with {
                    productId: productId,
                    status: status,
                    wishlistToken: wishlistToken,
                    productUsers: productUsers
                } only %}

            {% else %}

                <a href="{{ path('app_login', {redirect: path('app_wishlist', {token: wishlistToken})}) }}" class="w-full flex items-center justify-center text-sm font-semibold bg-[#FFF8F0] border border-[rgba(45,45,45,0.12)] text-[#2D2D2D] px-4 py-2 rounded-xl hover:bg-[#FFE66D] transition-colors">
                    Participer à ce cadeau
                </a>

            {% endif %}

        {% endif %}


        {# ====================================================== #}
        {# ACTIONS                                               #}
        {# ====================================================== #}

        <div class="flex items-center gap-2 mt-auto pt-2">


            {# ================================================== #}
            {# VOIR LE PRODUIT                                   #}
            {# ================================================== #}

            {% if url %}

                <a href="{{ url }}" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-xs font-semibold text-white bg-[#4ECDC4] hover:bg-[#3ab8b0] active:scale-95 transition px-3 py-1.5 rounded-lg">
                    Voir le produit
                </a>

            {% endif %}


            {# ================================================== #}
            {# JE L'AI ACHETÉ                                    #}
            {# uniquement pour un participant                    #}
            {# ================================================== #}

            {% if status.value != 'purchased' and app.user and hasReserved %}

                <form action="{{ path('app_product_mark_purchased', {token: wishlistToken, id: productId}) }}" method="post" class="ml-auto">

                    <input type="hidden" name="_token" value="{{ csrf_token('product-purchased-' ~ productId) }}">

                    <button type="submit" class="text-xs bg-[#FFF8F0] border border-[rgba(45,45,45,0.12)] text-[#2D2D2D] font-medium px-3 py-1.5 rounded-lg hover:bg-[#FFE66D] transition-colors">
                        Je l'ai acheté
                    </button>

                </form>

            {% endif %}

        </div>

    </div>

</article>
