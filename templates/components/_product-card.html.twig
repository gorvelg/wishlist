<article data-product-category="{{ category.value }}" data-product-status="{{ status.value }}" class="relative rounded-2xl h-full border bg-white overflow-hidden flex flex-col transition-shadow hover:shadow-lg border-[rgba(45,45,45,0.1)]">

    {# ========================================================== #}
    {# OVERLAY : PRODUIT ACHETÉ                                  #}
    {# ========================================================== #}

    {% if status.value == 'purchased' %}

        {% set canCancelPurchased = false %}

        {% if app.user %}

            {% if collaborative %}

                {% if buyer and buyer.id == app.user.id %}
                    {% set canCancelPurchased = true %}
                {% endif %}

            {% elseif hasReserved %}

                {% set canCancelPurchased = true %}

            {% endif %}

        {% endif %}

        <div class="absolute inset-0 bg-white/80 backdrop-blur-[1px] flex flex-col items-center justify-center gap-3 z-20 rounded-2xl">

            <div class="flex items-center gap-2 bg-green-100 text-green-700 border border-green-200 px-4 py-2 rounded-xl text-sm font-semibold">
                <span>✓</span>
                <span>Cadeau acheté</span>
            </div>

            {% if canCancelPurchased %}

                <form action="{{ path('app_product_cancel_purchased', {token: wishlistToken, id: productId}) }}" method="post">

                    <input type="hidden" name="_token" value="{{ csrf_token('cancel-purchased-' ~ productId) }}">

                    <button type="submit" class="text-xs font-medium text-[#6B6B6B] hover:text-[#FF6B6B] hover:underline transition">
                        Annuler l'achat
                    </button>

                </form>

            {% endif %}

        </div>

    {% endif %}


    {# ========================================================== #}
    {# IMAGE                                                     #}
    {# ========================================================== #}

    <div class="h-36 w-full overflow-hidden relative">


        {# ====================================================== #}
        {# ACTIONS PROPRIÉTAIRE                                  #}
        {# ====================================================== #}

        {% if isOwner %}

            <div data-controller="delete-product">


                <div class="absolute z-10 right-3 top-1 flex items-center gap-1">

                    <a href="{{ path('app_wishlist', {token: wishlistToken, edit: productId}) }}" aria-label="Modifier {{ name }}" class="bg-white rounded-full p-0.5 shadow-2xl text-[#2D2D2D] hover:text-[#4ECDC4] transition-colors">
                        {% include 'components/icons/edit.html.twig' %}
                    </a>

                    <button type="button" data-action="click->delete-product#open" aria-label="Supprimer {{ name }}" class="text-[#2D2D2D] hover:text-red-700 transition-colors block bg-white rounded-full p-0.5 shadow-2xl">
                        {% include 'components/icons/trash.html.twig' %}
                    </button>

                </div>

                {% include 'components/_delete-product-modal.html.twig' with {
                    productId: productId,
                    name: name
                } only %}

            </div>

        {% endif %}

        {% if image %}

            {% set imageSrc = image %}

            {% if not (image starts with 'http://' or image starts with 'https://') %}
                {% set imageSrc = asset(product_upload_path ~ image) %}
            {% endif %}

            <img class="w-full h-full object-cover" src="{{ imageSrc }}" alt="{{ name }}">

        {% else %}

            <div class="w-full h-full flex items-center justify-center bg-[#FFF8F0] text-[#6B6B6B] text-sm">
                Aucune image
            </div>

        {% endif %}

        <div class="absolute inset-0" style="background: linear-gradient(transparent 40%, rgba(0, 0, 0, 0.18) 100%);"></div>

        {% set variants = {
            meal: 'bg-blue-200 text-blue-700 ring-blue-700/10',
            hygiene: 'bg-green-200 text-green-700 ring-green-600/20',
            awakening: 'bg-purple-200 text-purple-700 ring-purple-700/10',
            travel: 'bg-red-200 text-red-700 ring-red-600/10',
            bedroom: 'bg-gray-200 text-gray-600 ring-gray-500/10',
            clothing: 'bg-pink-200 text-pink-700 ring-pink-600/20',
        } %}

        {% set variantClasses = variants[category.value]  %}


        <div class="absolute bottom-0 left-0 h-1 w-full {{ variantClasses }}"></div>


        {% set badgeColors = [
            'bg-red-100 text-red-700',
            'bg-blue-100 text-blue-700',
            'bg-green-100 text-green-700',
            'bg-yellow-100 text-yellow-700',
            'bg-purple-100 text-purple-700',
            'bg-pink-100 text-pink-700',
            'bg-orange-100 text-orange-700',
            'bg-teal-100 text-teal-700'
        ] %}


        {% if productUsers|length > 0 %}

            <div class="absolute left-5 bottom-2.5 flex items-center gap-1">

                {% for productUser in productUsers %}

                    {% set user = productUser.user %}
                    {% set color = badgeColors[user.id % badgeColors|length] %}

                    <span class="flex items-center justify-center size-7 rounded-full border-2 border-white text-xs font-semibold {{ color }}" title="{{ user.firstname }} {{ user.lastname }}{% if productUser.amount %} — {{ productUser.amount|number_format(2, ',', ' ') }} €{% endif %}">
                        {{ user.initials }}
                    </span>

                {% endfor %}

            </div>

        {% endif %}

    </div>

    <div class="p-5 flex flex-col gap-4 flex-1 bg-white">

        <div>

            <div class="flex justify-between items-start gap-2">

                <h3 class="font-semibold text-[#2D2D2D]">
                    {{ name }}
                </h3>

                {% include 'components/_tag.html.twig' with {
                    label: category.toFrench(),
                    variantClasses: variantClasses
                } only %}

            </div>


            {% if description is not null and description != '' %}

                <p class="text-xs text-[#6B6B6B] mt-2 leading-relaxed">
                    {{ description }}
                </p>

            {% endif %}

        </div>


        <p class="text-lg font-semibold text-[#2D2D2D]">
            {{ price|number_format(2, ',', ' ') }} €
        </p>


        {% if status.value != 'purchased' and not collaborative and productUsers|length == 0 %}

            {% if app.user %}

                <div data-controller="participation">


                    <div data-participation-target="choices" class="flex items-center gap-2">


                        <form method="post" action="{{ path('app_product_offer', {token: wishlistToken, id: productId}) }}" class="flex-1">

                            <input type="hidden" name="_token" value="{{ csrf_token('offer-' ~ productId) }}">

                            <button type="submit" class="w-full text-xs font-semibold px-3.5 py-2 rounded-lg bg-[#FFE66D] text-[#2D2D2D] hover:bg-[#ffd93d] active:scale-95 transition">
                                Offrir
                            </button>

                        </form>


                        <button type="button" data-action="click->participation#showForm" class="flex-1 text-xs font-semibold px-3.5 py-2 rounded-lg bg-[#FFF8F0] border border-[rgba(45,45,45,0.12)] text-[#2D2D2D] hover:bg-[#FFE66D] active:scale-95 transition">
                            Offrir à plusieurs
                        </button>

                    </div>

                    <div data-participation-target="form" class="hidden">

                        {% include 'components/_participation-form.html.twig' with {
                            productId: productId,
                            status: status,
                            wishlistToken: wishlistToken,
                            productUsers: productUsers
                        } only %}

                        <button type="button" data-action="click->participation#hideForm" class="text-xs text-[#6B6B6B] hover:text-[#2D2D2D] hover:underline mt-2">
                            Annuler
                        </button>

                    </div>

                </div>


            {% else %}

                <div class="flex items-center gap-2">

                    <a href="{{ path('app_login', {redirect: path('app_wishlist', {token: wishlistToken})}) }}" class="flex-1 text-center text-xs font-semibold px-3.5 py-2 rounded-lg bg-[#FFE66D] text-[#2D2D2D] hover:bg-[#ffd93d] transition">
                        Offrir
                    </a>

                    <a href="{{ path('app_login', {redirect: path('app_wishlist', {token: wishlistToken})}) }}" class="flex-1 text-center text-xs font-semibold px-3.5 py-2 rounded-lg bg-[#FFF8F0] border border-[rgba(45,45,45,0.12)] text-[#2D2D2D] hover:bg-[#FFE66D] transition">
                        Offrir à plusieurs
                    </a>

                </div>

            {% endif %}

        {% endif %}


        {% if collaborative %}

            <div class="rounded-xl bg-[#FFF8F0] border border-[rgba(45,45,45,0.08)] px-3.5 py-3 flex flex-col gap-0">


                <div>

                    <div class="flex items-center justify-between text-xs text-[#6B6B6B] mb-2">

                        <span>
                            {{ contributedAmount|number_format(2, ',', ' ') }} € récolté
                        </span>

                        <span>
                            {{ contributionPercent|number_format(0) }} %
                        </span>

                    </div>


                    <div class="h-2 w-full rounded-full bg-[rgba(45,45,45,0.08)] overflow-hidden">

                        <div class="h-full rounded-full transition-all duration-500" style="width: {{ contributionPercent }}%; background: linear-gradient(90deg, rgb(255, 230, 109), rgb(255, 154, 92));"></div>

                    </div>

                    {% if remainingAmount > 0 %}

                        <div class="text-xs text-[#6B6B6B] mt-2">
                            Il reste
                            <strong class="text-[#2D2D2D]">
                                {{ remainingAmount|number_format(2, ',', ' ') }} €
                            </strong>
                            à financer
                        </div>

                    {% else %}

                        <div class="flex items-center gap-1 text-xs font-semibold text-[#4ECDC4] mt-2">
                            <span>✓</span>
                            <span>Montant atteint</span>
                        </div>

                    {% endif %}

                    {% if productUsers|length > 0 %}

                        <div class="mt-2">

                            {% include 'components/_participants-modal.html.twig' with {
                                productId: productId,
                                productUsers: productUsers,
                                contributedAmount: contributedAmount
                            } only %}

                        </div>

                    {% endif %}

                    {% if app.user and hasReserved %}

                        <div class="mt-2">

                            {% include 'components/_product-discussion.html.twig' with {
                                productId: productId,
                                wishlistToken: wishlistToken,
                                productMessages: productMessages,
                                openDiscussion: openDiscussion,
                                unreadMessageCount: unreadMessageCount
                            } only %}

                        </div>

                    {% endif %}

                </div>

                <div class="mt-3 pt-3 border-t border-[rgba(45,45,45,0.08)]">

                    {% if buyer %}

                        <div class="flex items-center gap-3">

            <span class="flex items-center justify-center size-8 rounded-full bg-[#ffb4b4] text-sm shrink-0">
                <img src="{{ asset('images/trolley.png') }}" alt="caddie" class="size-4">
            </span>

                            <div class="flex-1 min-w-0">

                                {% if app.user and buyer.id == app.user.id %}

                                    <p class="text-xs font-semibold text-[#2D2D2D]">
                                        Vous vous chargez de l'achat
                                    </p>

                                    <p class="text-xs text-[#6B6B6B] mt-0.5">
                                        Vous pourrez indiquer lorsque le cadeau aura été acheté.
                                    </p>

                                {% else %}

                                    <p class="text-xs font-semibold text-[#2D2D2D]">
                                        {{ buyer.firstname }}{% if buyer.lastname %} {{ buyer.lastname|slice(0, 1)|upper }}.{% endif %} se charge de l'achat
                                    </p>

                                    <p class="text-xs text-[#6B6B6B] mt-0.5">
                                        Les participants peuvent s'organiser dans la discussion.
                                    </p>

                                {% endif %}

                            </div>

                        </div>

                        {% if app.user and buyer.id == app.user.id and status.value != 'purchased' %}

                            <form method="post" action="{{ path('app_product_buyer_cancel', {token: wishlistToken, id: productId}) }}" class="mt-2 ml-11">

                                <input type="hidden" name="_token" value="{{ csrf_token('cancel-buyer-' ~ productId) }}">

                                <button type="submit" class="text-xs text-[#FF6B6B] hover:underline">
                                    Je ne m'en charge plus
                                </button>

                            </form>

                        {% endif %}


                    {% else %}

                        <div class="flex items-start gap-3">

            <span class="flex items-center justify-center size-8 rounded-full bg-[#FFF8F0] border border-[rgba(45,45,45,0.08)] text-sm shrink-0">
                <img src="{{ asset('images/trolley.png') }}" alt="caddie" class="size-4">
            </span>

                            <div class="flex-1">

                                <p class="text-xs font-semibold text-[#2D2D2D]">
                                    Qui se charge de l'achat ?
                                </p>

                                <p class="text-xs text-[#6B6B6B] mt-0.5">
                                    Aucun participant ne s'est encore proposé pour commander ce cadeau.
                                </p>


                                {% if app.user and hasReserved and status.value != 'purchased' %}

                                    <form method="post" action="{{ path('app_product_buyer', {token: wishlistToken, id: productId}) }}" class="mt-2">

                                        <input type="hidden" name="_token" value="{{ csrf_token('buyer-' ~ productId) }}">

                                        <button type="submit" class="text-xs font-semibold bg-[#FFE66D] text-[#2D2D2D] px-3.5 py-2 rounded-lg hover:bg-[#ffd93d] active:scale-95 transition">
                                            Je me charge de l'achat
                                        </button>

                                    </form>

                                {% endif %}

                            </div>

                        </div>

                    {% endif %}

                </div>

                {% if remainingAmount > 0 and status.value != 'purchased' %}

                    {% if app.user %}

                        {% include 'components/_participation-form.html.twig' with {
                            productId: productId,
                            status: status,
                            wishlistToken: wishlistToken,
                            productUsers: productUsers
                        } only %}

                    {% else %}

                        <a href="{{ path('app_login', {redirect: path('app_wishlist', {token: wishlistToken})}) }}" class="w-full flex items-center justify-center mt-3 text-xs font-semibold bg-[#FFE66D] text-[#2D2D2D] px-4 py-2 rounded-lg hover:bg-[#ffd93d] transition">
                            Participer
                        </a>

                    {% endif %}

                {% endif %}


                {% if remainingAmount <= 0 and app.user %}

                    {% set myParticipations = productUsers|filter(participation => participation.user.id == app.user.id) %}
                    {% set myParticipation = myParticipations|first %}

                    {% if myParticipation %}

                        <div class="mt-3 pt-3 border-t border-[rgba(45,45,45,0.08)]">

                            <p class="text-xs text-[#6B6B6B]">
                                Votre participation :
                                <strong class="text-[#2D2D2D]">
                                    {{ myParticipation.amount|number_format(2, ',', ' ') }} €
                                </strong>
                            </p>

                            <form method="post" action="{{ path('app_product_cancel_participation', {token: wishlistToken, id: productId}) }}" class="mt-1">

                                <input type="hidden" name="_token" value="{{ csrf_token('cancel-participation-' ~ productId) }}">

                                <button type="submit" class="text-xs text-[#FF6B6B] hover:underline">
                                    Annuler ma participation
                                </button>

                            </form>

                        </div>

                    {% endif %}

                {% endif %}

            </div>

        {% endif %}

        {% if not collaborative and productUsers|length > 0 and status.value != 'purchased' %}

            <div class="rounded-xl bg-[#FFF8F0] border border-[rgba(45,45,45,0.08)] px-3.5 py-3">

                <div class="flex items-center gap-2">

                    <span class="flex items-center justify-center size-7 rounded-full bg-[#FFE66D] text-[#2D2D2D] text-sm shrink-0">
                        ✓
                    </span>

                    <div class="flex-1">

                        <p class="text-xs font-semibold text-[#2D2D2D]">
                            Ce cadeau est pris en charge
                        </p>


                        {% if app.user and hasReserved %}

                            <p class="text-xs text-[#6B6B6B]">
                                Vous avez choisi d'offrir ce cadeau.
                            </p>

                        {% else %}

                            <p class="text-xs text-[#6B6B6B]">
                                Quelqu'un a choisi de l'offrir.
                            </p>

                        {% endif %}

                    </div>

                </div>

                {% if app.user and hasReserved %}

                    <form method="post" action="{{ path('app_product_cancel_participation', {token: wishlistToken, id: productId}) }}" class="mt-2 ml-9">

                        <input type="hidden" name="_token" value="{{ csrf_token('cancel-participation-' ~ productId) }}">

                        <button type="submit" class="text-xs text-[#FF6B6B] hover:underline">
                            Annuler
                        </button>

                    </form>

                {% endif %}

            </div>

        {% endif %}

        <div class="flex items-center gap-2 mt-auto pt-2">

            {% if url %}

                <a href="{{ url }}" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-xs font-semibold text-white bg-[#4ECDC4] hover:bg-[#3ab8b0] active:scale-95 transition px-3.5 py-2 rounded-lg">
                    Voir le produit
                </a>

            {% endif %}

            {% set canMarkPurchased = false %}

            {% if app.user and status.value != 'purchased' %}

                {% if collaborative %}

                    {% if buyer and buyer.id == app.user.id %}
                        {% set canMarkPurchased = true %}
                    {% endif %}

                {% elseif hasReserved %}

                    {% set canMarkPurchased = true %}

                {% endif %}

            {% endif %}


            {% if canMarkPurchased %}

                <form action="{{ path('app_product_mark_purchased', {token: wishlistToken, id: productId}) }}" method="post" class="ml-auto">

                    <input type="hidden" name="_token" value="{{ csrf_token('product-purchased-' ~ productId) }}">

                    <button type="submit" class="text-xs bg-[#FFF8F0] border border-[rgba(45,45,45,0.12)] text-[#2D2D2D] font-medium px-3.5 py-2 rounded-lg hover:bg-[#FFE66D] transition-colors">
                        Je l'ai acheté
                    </button>

                </form>

            {% endif %}

        </div>

    </div>

</article>
