{% if app.user and status.value != 'purchased' %}

    {% set myParticipations = productUsers|filter(
        participation => participation.user.id == app.user.id
    ) %}

    {% set myParticipation = myParticipations|first %}

    <form
        method="post"
        action="{{ path('app_product_purchase', {
            token: wishlistToken,
            id: productId
        }) }}"
        class="mt-4"
    >

        <input
            type="hidden"
            name="_token"
            value="{{ csrf_token('purchase-' ~ productId) }}"
        >

        <label class="text-xs font-medium text-[#6B6B6B] mb-1 block">
            {% if myParticipation %}
                Modifier ma participation
            {% else %}
                Ma participation
            {% endif %}
        </label>

        <div class="flex gap-2">

            <div class="relative flex-1">

                <input
                    type="number"
                    name="amount"
                    min="0.01"
                    step="0.01"
                    value="{{ myParticipation ? myParticipation.amount : '' }}"
                    placeholder="50"
                    required
                    class="w-full rounded-xl border border-[rgba(45,45,45,0.15)] px-3 py-1.5 pr-8 text-sm focus:outline-none focus:ring-2 focus:ring-[#4ECDC4]/40"
                >

                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-sm text-[#6B6B6B]">
                    €
                </span>

            </div>

            <button
                type="submit"
                class="flex items-center gap-1 text-xs font-semibold text-white bg-[#4ECDC4] hover:bg-[#3ab8b0] active:scale-95 transition px-3 py-1.5 rounded-lg"
            >
                {% if myParticipation %}
                    Modifier
                {% else %}
                    Participer
                {% endif %}
            </button>

        </div>

    </form>

    {% if myParticipation %}

        <p class="text-xs text-[#6B6B6B] mt-2">
            Votre participation actuelle :
            <strong>
                {{ myParticipation.amount|number_format(2, ',', ' ') }} €
            </strong>
        </p>

        <form
            method="post"
            action="{{ path('app_product_cancel_participation', {
                token: wishlistToken,
                id: productId
            }) }}"
            class="mt-2"
        >

            <input
                type="hidden"
                name="_token"
                value="{{ csrf_token('cancel-participation-' ~ productId) }}"
            >

            <button
                type="submit"
                class="text-xs text-[#FF6B6B] hover:underline"
            >
                Annuler ma participation
            </button>

        </form>

    {% endif %}

{% endif %}
