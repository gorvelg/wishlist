{% extends 'base.html.twig' %}

{% block title %}
    À propos de bébé
{% endblock %}

{% block body %}

    <div
        class="min-h-screen bg-[#FFF8F0] flex flex-col"
        style="font-family: Outfit, system-ui, sans-serif"
    >

        {# ===================================================== #}
        {# HEADER                                                #}
        {# ===================================================== #}

        {% include 'components/_navbar-simple.html.twig' %}

        {# ===================================================== #}
        {# CONTENT                                               #}
        {# ===================================================== #}

        <div
            class="
                flex-1
                flex
                flex-col
                items-center
                justify-center
                px-6
                py-12
            "
        >

            <div class="w-full max-w-xl">


                {# ================================================= #}
                {# PROGRESS                                          #}
                {# ================================================= #}

                <div
                    class="
                        flex
                        items-center
                        justify-center
                        mb-10
                    "
                >

                    {# Étape 1 terminée #}

                    <div class="flex items-center gap-2">

                        <div
                            class="
                                w-8
                                h-8
                                rounded-full
                                flex
                                items-center
                                justify-center
                                text-xs
                                font-bold
                                bg-[#FF6B6B]
                                text-white
                            "
                        >
                            ✓
                        </div>

                        <div
                            class="w-12 h-0.5 bg-[#FF6B6B]"
                        ></div>

                    </div>


                    {# Étape 2 active #}

                    <div class="flex items-center gap-2">

                        <div
                            class="
                                w-8
                                h-8
                                rounded-full
                                flex
                                items-center
                                justify-center
                                text-xs
                                font-bold
                                bg-[#FF6B6B]
                                text-white
                            "
                        >
                            2
                        </div>

                        <div
                            class="
                                w-12
                                h-0.5
                                bg-[rgba(45,45,45,0.12)]
                            "
                        ></div>

                    </div>


                    {# Étape 3 #}

                    <div class="flex items-center gap-2">

                        <div
                            class="
                                w-8
                                h-8
                                rounded-full
                                flex
                                items-center
                                justify-center
                                text-xs
                                font-bold
                                bg-white
                                border-2
                                border-[rgba(45,45,45,0.15)]
                                text-[#6B6B6B]
                            "
                        >
                            3
                        </div>

                    </div>

                </div>


                {# ================================================= #}
                {# CARD                                              #}
                {# ================================================= #}

                <div
                    class="
                        bg-white
                        rounded-3xl
                        border
                        border-[rgba(45,45,45,0.08)]
                        shadow-sm
                        p-8
                    "
                >

                    {# ============================================= #}
                    {# TITLE                                         #}
                    {# ============================================= #}

                    <div class="mb-7">

                        <p
                            class="
                                text-xs
                                font-semibold
                                text-[#FF6B6B]
                                uppercase
                                tracking-widest
                                mb-1
                            "
                        >
                            Étape 2 sur 3
                        </p>


                        <h1
                            class="
                                text-3xl
                                font-semibold
                                text-[#2D2D2D]
                            "
                            style="
                                font-family:
                                    Fraunces,
                                    Georgia,
                                    serif
                            "
                        >
                            À propos de bébé
                        </h1>


                        <p
                            class="
                                text-[#6B6B6B]
                                text-sm
                                mt-1
                            "
                        >
                            Quelques informations pour personnaliser
                            sa liste de naissance.
                        </p>

                    </div>


                    {# ============================================= #}
                    {# FORM                                          #}
                    {# ============================================= #}

                    {{ form_start(form, {
                        attr: {
                            class: 'flex flex-col gap-5'
                        }
                    }) }}


                    {# ========================================= #}
                    {# BABY NAME                                 #}
                    {# ========================================= #}

                    <div>

                        {{ form_label(
                            form.babyName,
                            'Prénom du bébé',
                            {
                                label_attr: {
                                class: 'text-xs font-semibold text-[#6B6B6B] uppercase tracking-wide mb-1.5 block'
                            }
                            }
                        ) }}


                        {{ form_widget(
                            form.babyName,
                            {
                                attr: {
                                placeholder: 'Ex. Louise',
                                class: 'w-full bg-[#FFF8F0] border border-[rgba(45,45,45,0.12)] rounded-xl px-4 py-3 text-sm text-[#2D2D2D] focus:outline-none focus:ring-2 focus:ring-[#FF6B6B]/40 transition'
                            }
                            }
                        ) }}


                        <p
                            class="
                                    text-xs
                                    text-[#6B6B6B]
                                    mt-1.5
                                "
                        >
                            Pas encore choisi ?
                            Aucun problème, vous pourrez
                            l’ajouter plus tard.
                        </p>


                        {% if form.babyName.vars.errors|length > 0 %}

                            <div
                                class="
                                        text-xs
                                        text-red-500
                                        mt-1.5
                                    "
                            >
                                {{ form_errors(form.babyName) }}
                            </div>

                        {% endif %}

                    </div>


                    {# ========================================= #}
                    {# DUE DATE                                  #}
                    {# ========================================= #}

                    <div>

                        {{ form_label(
                            form.dueDate,
                            'Date prévue d’arrivée',
                            {
                                label_attr: {
                                class: 'text-xs font-semibold text-[#6B6B6B] uppercase tracking-wide mb-1.5 block'
                            }
                            }
                        ) }}


                        {{ form_widget(
                            form.dueDate,
                            {
                                attr: {
                                class: 'w-full bg-[#FFF8F0] border border-[rgba(45,45,45,0.12)] rounded-xl px-4 py-3 text-sm text-[#2D2D2D] focus:outline-none focus:ring-2 focus:ring-[#FF6B6B]/40 transition'
                            }
                            }
                        ) }}


                        {% if form.dueDate.vars.errors|length > 0 %}

                            <div
                                class="
                                        text-xs
                                        text-red-500
                                        mt-1.5
                                    "
                            >
                                {{ form_errors(form.dueDate) }}
                            </div>

                        {% endif %}

                    </div>


                    {# ========================================= #}
                    {# NAVIGATION                                #}
                    {# ========================================= #}

                    <div
                        class="
                                flex
                                items-center
                                gap-3
                                pt-2
                            "
                    >

                        <a
                            href="{{ path(
                                'app_wishlist_create',
                                {
                                    step: 'family'
                                }
                            ) }}"
                            class="
                                    flex-1
                                    text-center
                                    bg-white
                                    border
                                    border-[rgba(45,45,45,0.12)]
                                    text-[#2D2D2D]
                                    font-semibold
                                    py-3.5
                                    rounded-xl
                                    hover:bg-[#FFF8F0]
                                    transition
                                "
                        >
                            ← Retour
                        </a>


                        <button
                            type="submit"
                            class="
                                    flex-1
                                    bg-[#FF6B6B]
                                    text-white
                                    font-semibold
                                    py-3.5
                                    rounded-xl
                                    hover:bg-[#e85555]
                                    active:scale-[0.98]
                                    transition
                                    disabled:opacity-40
                                    disabled:cursor-not-allowed
                                "
                        >
                            Continuer →
                        </button>

                    </div>


                    {{ form_end(form) }}

                </div>

            </div>

        </div>

    </div>

{% endblock %}
