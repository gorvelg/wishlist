{% extends 'base.html.twig' %}

{% block title %}
    Création de votre liste
{% endblock %}

{% block body %}

    <div
        class="min-h-screen bg-[#FFF8F0] flex flex-col"
        style="font-family: Outfit, system-ui, sans-serif"
    >

        {# ===================================================== #}
        {# HEADER                                                #}
        {# ===================================================== #}

        <header
            class="flex items-center justify-between px-8 py-5 border-b border-[rgba(45,45,45,0.07)] bg-white"
        >

            <a
                class="flex items-center gap-2"
                href="/"
            >
                <span class="text-xl">
                    🌿
                </span>

                <span
                    class="text-lg font-semibold text-[#2D2D2D]"
                    style="font-family: Fraunces, Georgia, serif"
                >
                    Wren
                </span>
            </a>


            <a
                class="text-sm text-[#6B6B6B] hover:text-[#2D2D2D] transition"
                href="/dashboard"
            >
                Annuler
            </a>

        </header>


        {# ===================================================== #}
        {# CONTENT                                               #}
        {# ===================================================== #}

        <div
            class="flex-1 flex flex-col items-center justify-center px-6 py-12"
        >

            <div class="w-full max-w-xl">


                {# ================================================= #}
                {# PROGRESS                                          #}
                {# ================================================= #}

                <div class="flex items-center justify-center mb-10">

                    <div class="flex items-center gap-2">

                        <div
                            class="
                                w-8
                                h-8
                                rounded-full
                                flex
                                items-center
                                justify-center
                                text-xs
                                font-bold
                                transition-all
                                bg-[#FF6B6B]
                                text-white
                            "
                        >
                            1
                        </div>

                        <div
                            class="w-12 h-0.5 bg-[rgba(45,45,45,0.12)]"
                        ></div>

                    </div>


                    <div class="flex items-center gap-2">

                        <div
                            class="
                                w-8
                                h-8
                                rounded-full
                                flex
                                items-center
                                justify-center
                                text-xs
                                font-bold
                                transition-all
                                bg-white
                                border-2
                                border-[rgba(45,45,45,0.15)]
                                text-[#6B6B6B]
                            "
                        >
                            2
                        </div>

                        <div
                            class="w-12 h-0.5 bg-[rgba(45,45,45,0.12)]"
                        ></div>

                    </div>


                    <div class="flex items-center gap-2">

                        <div
                            class="
                                w-8
                                h-8
                                rounded-full
                                flex
                                items-center
                                justify-center
                                text-xs
                                font-bold
                                transition-all
                                bg-white
                                border-2
                                border-[rgba(45,45,45,0.15)]
                                text-[#6B6B6B]
                            "
                        >
                            3
                        </div>

                    </div>

                </div>


                {# ================================================= #}
                {# CARD                                              #}
                {# ================================================= #}

                <div
                    class="
                        bg-white
                        rounded-3xl
                        border
                        border-[rgba(45,45,45,0.08)]
                        shadow-sm
                        p-8
                    "
                >

                    {# ============================================= #}
                    {# HEADER                                        #}
                    {# ============================================= #}

                    <div class="mb-7">

                        <p
                            class="
                                text-xs
                                font-semibold
                                text-[#FF6B6B]
                                uppercase
                                tracking-widest
                                mb-1
                            "
                        >
                            Étape 1 sur 3
                        </p>


                        <h1
                            class="
                                text-3xl
                                font-semibold
                                text-[#2D2D2D]
                            "
                            style="font-family: Fraunces, Georgia, serif"
                        >
                            Créons votre liste de naissance
                        </h1>


                        <p
                            class="text-[#6B6B6B] text-sm mt-1"
                        >
                            Commençons par faire connaissance.
                        </p>

                    </div>


                    {# ============================================= #}
                    {# FORM                                          #}
                    {# ============================================= #}

                    {{ form_start(form, {
                        attr: {
                            class: 'flex flex-col gap-5'
                        }
                    }) }}


                    {# ========================================= #}
                    {# NOM DE LA LISTE                           #}
                    {# ========================================= #}

                    <div>

                        {{ form_label(
                            form.name,
                            'Titre de la liste de naissance',
                            {
                                label_attr: {
                                class: 'text-xs font-semibold text-[#6B6B6B] uppercase tracking-wide mb-1.5 block'
                            }
                            }
                        ) }}


                        {{ form_widget(
                            form.name,
                            {
                                attr: {
                                placeholder: 'Ex. Liste de naissance de bébé',
                                class: 'w-full bg-[#FFF8F0] border border-[rgba(45,45,45,0.12)] rounded-xl px-4 py-3 text-sm text-[#2D2D2D] focus:outline-none focus:ring-2 focus:ring-[#FF6B6B]/40 transition'
                            }
                            }
                        ) }}


                        {% if form.name.vars.errors|length > 0 %}

                            <div
                                class="text-xs text-red-500 mt-1.5"
                            >
                                {{ form_errors(form.name) }}
                            </div>

                        {% endif %}

                    </div>


                    {# ========================================= #}
                    {# NOMS DES PARENTS                          #}
                    {# ========================================= #}

                    <div>

                        {{ form_label(
                            form.parentsNames,
                            'Nom(s) des parents',
                            {
                                label_attr: {
                                class: 'text-xs font-semibold text-[#6B6B6B] uppercase tracking-wide mb-1.5 block'
                            }
                            }
                        ) }}


                        {{ form_widget(
                            form.parentsNames,
                            {
                                attr: {
                                placeholder: 'Ex. Léa & Thomas',
                                class: 'w-full bg-[#FFF8F0] border border-[rgba(45,45,45,0.12)] rounded-xl px-4 py-3 text-sm text-[#2D2D2D] focus:outline-none focus:ring-2 focus:ring-[#FF6B6B]/40 transition'
                            }
                            }
                        ) }}


                        {% if form.parentsNames.vars.errors|length > 0 %}

                            <div
                                class="text-xs text-red-500 mt-1.5"
                            >
                                {{ form_errors(form.parentsNames) }}
                            </div>

                        {% endif %}

                    </div>

                    {# ========================================= #}
                    {# MESSAGE POUR LES VISITEURS                #}
                    {# ========================================= #}

                    <div>

                        {{ form_label(
                            form.message,
                            'Un petit mot pour vos proches',
                            {
                                label_attr: {
                                class: 'text-xs font-semibold text-[#6B6B6B] uppercase tracking-wide mb-1.5 block'
                            }
                            }
                        ) }}

                        {{ form_widget(
                            form.message,
                            {
                                attr: {
                                rows: 3,
                                placeholder: 'Nous sommes heureux de partager cette belle aventure avec vous…',
                                class: 'w-full bg-[#FFF8F0] border border-[rgba(45,45,45,0.12)] rounded-xl px-4 py-3 text-sm text-[#2D2D2D] focus:outline-none focus:ring-2 focus:ring-[#FF6B6B]/40 transition resize-none'
                            }
                            }
                        ) }}

                        {% if form.message.vars.errors|length > 0 %}
                            <div class="text-xs text-red-500 mt-1.5">
                                {{ form_errors(form.message) }}
                            </div>
                        {% endif %}

                    </div>


                    {# ========================================= #}
                    {# SUBMIT                                    #}
                    {# ========================================= #}

                    <button
                        type="submit"
                        class="
                                w-full
                                mt-2
                                bg-[#FF6B6B]
                                text-white
                                font-semibold
                                py-3.5
                                rounded-xl
                                hover:bg-[#e85555]
                                active:scale-[0.98]
                                transition
                                disabled:opacity-40
                                disabled:cursor-not-allowed
                            "
                    >
                        Continuer →
                    </button>


                    {{ form_end(form) }}

                </div>

            </div>

        </div>

    </div>

{% endblock %}
