{% extends 'base.html.twig' %}

{% block title %}Wishlist{% endblock %}

{% block body %}
    <header class="relative overflow-hidden bg-[#FFF8F0] pt-16 pb-12 px-6">
        <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
            <div class="absolute -top-10 -left-10 w-40 h-40 rounded-full bg-[#FFE66D] opacity-40">

            </div>
            <svg class="absolute top-4 right-16 opacity-30" width="80" height="80" viewBox="0 0 80 80"><polygon points="40,4 76,76 4,76" fill="#4ECDC4"></polygon></svg>
            <svg class="absolute top-1/2 -left-6 opacity-20" width="60" height="120" viewBox="0 0 60 120"><path d="M30 0 C60 20 0 40 30 60 C60 80 0 100 30 120" stroke="#FF6B6B" stroke-width="6" fill="none" stroke-linecap="round"></path></svg>
            <div class="absolute -bottom-16 -right-16 w-56 h-56 rounded-full bg-[#C7B8EA] opacity-30"></div><div class="absolute top-1/3 right-8 w-24 h-24 opacity-20" style="background-image: radial-gradient(circle, rgb(255, 107, 107) 2px, transparent 2px); background-size: 10px 10px;">

            </div>
        </div>
        <div class="relative z-10 max-w-3xl mx-auto text-center">
            <div class="inline-flex items-center gap-2 bg-white border border-[rgba(45,45,45,0.1)] rounded-full px-4 py-1.5 text-xs font-medium text-[#6B6B6B] mb-6 shadow-sm">
                <span>🌿</span> Janvier 2027
            </div>
            <h1 class="font-title text-5xl sm:text-6xl font-semibold text-[#2D2D2D] leading-tight mb-3">
                {{ wishlist.name }}
            </h1>
            <p class="text-[#6B6B6B] text-lg max-w-md mx-auto leading-relaxed">
                Nous vous remercions pour votre présence ! Choisissez l'article que vous souhaitez dans notre liste afin de nous aider à accueillir ce petit être dans ce monde !
            </p>
            <div class="flex items-center justify-center gap-6 mt-8"><div class="text-center">
                    <div class="font-title text-3xl font-semibold text-[#2D2D2D]">{{ countProducts }}</div>
                    <div class="text-xs text-[#6B6B6B] font-medium">Souhaits</div>
                </div>
                <div class="w-px h-8 bg-[rgba(45,45,45,0.1)]">

                </div>
                <div class="text-center">
                    <div class="font-title text-3xl font-semibold text-[#4ECDC4]">{{ giftedProducts }}</div>
                    <div class="text-xs text-[#6B6B6B] font-medium">Offerts</div>
                </div>
                <div class="w-px h-8 bg-[rgba(45,45,45,0.1)]"></div>
                <div class="text-center">
                    <div class="font-title text-3xl font-semibold text-[#FF6B6B]">{{ remainingProducts }}</div>
                    <div class="text-xs text-[#6B6B6B] font-medium">Restants</div>
                </div>
            </div>
        </div>
    </header>

    <div class="max-w-5xl mx-auto px-6 py-6">
        <div class="flex flex-wrap items-center gap-3 justify-between">
            <div
                class="flex items-center gap-3"
                data-controller="modal"
            >
                <button
                    class="flex items-center gap-2 bg-[#FF6B6B] text-white text-sm font-semibold px-5 py-2 rounded-full hover:bg-[#e85555] active:scale-95 transition shadow-sm"
                    type="button"
                    data-action="click->modal#open"
                >
                    <span class="text-base leading-none">+
                    </span> Ajouter
                </button>
                {% include 'components/_product-modal.html.twig' %}
            </div>
        </div>
    </div>

    <main class="max-w-5xl mx-auto px-6 pb-20">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {% for product in products %}
                {% include ('components/_product-card.html.twig') with {
                    name: product.name,
                    description: product.description,
                    image: product.image
                } only %}
            {% endfor %}
        </div>
    </main>

{% endblock %}
