{% extends 'base.html.twig' %}

{% block title %}
    Mot de passe oublié
{% endblock %}

{% block body %}

    <main class="min-h-screen bg-[#FFF8F0] flex items-center justify-center px-4 py-12">

        <div class="w-full max-w-md">

            <div class="bg-white rounded-3xl border border-[rgba(45,45,45,0.1)] shadow-sm px-6 sm:px-8 py-8">

                <div class="text-center mb-7">

                    <div class="flex items-center justify-center size-12 mx-auto rounded-full bg-[#FFE66D]/40 mb-4">
                        🔑
                    </div>

                    <h1 class="font-title text-3xl font-semibold text-[#2D2D2D]">
                        Mot de passe oublié ?
                    </h1>

                    <p class="text-sm text-[#6B6B6B] leading-relaxed mt-2">
                        Saisissez l'adresse e-mail associée à votre compte Nidou.
                    </p>

                </div>

                {{ form_start(requestForm) }}

                <div>

                    <label for="{{ requestForm.email.vars.id }}" class="block text-sm font-medium text-[#6B6B6B] mb-1.5">
                        Adresse e-mail
                    </label>

                    {{ form_widget(requestForm.email, {
                        attr: {
                            class: 'w-full rounded-xl border border-[rgba(45,45,45,0.15)] px-4 py-3 text-sm text-[#2D2D2D] placeholder:text-[#6B6B6B]/60 focus:outline-none focus:ring-2 focus:ring-[#4ECDC4]/40',
                            placeholder: 'vous@exemple.fr',
                            autocomplete: 'email'
                        }
                    }) }}

                    <div class="text-xs text-[#FF6B6B] mt-1">
                        {{ form_errors(requestForm.email) }}
                    </div>

                </div>


                <button type="submit" class="w-full mt-5 bg-[#2D2D2D] text-white text-sm font-semibold px-5 py-3 rounded-xl hover:bg-[#444] active:scale-[0.99] transition">
                    Recevoir le lien
                </button>

                {{ form_end(requestForm) }}


                <div class="text-center mt-6">

                    <a href="{{ path('app_login') }}" class="text-xs font-medium text-[#6B6B6B] hover:text-[#2D2D2D] hover:underline transition">
                        ← Retour à la connexion
                    </a>

                </div>

            </div>

        </div>

    </main>

{% endblock %}
